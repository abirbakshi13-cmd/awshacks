# Copy this file to .env.local and fill in values.
# .env.local is gitignored; this file is tracked and safe to commit.

# API Gateway base URL — no trailing slash.
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE_URL=

# Set to "false" to switch from mock data to real API calls.
# Any other value (or omitting this variable) keeps mocks enabled.
VITE_USE_MOCKS=true
